# Domain and routing
ROADLYTICS_DOMAIN=your-domain.example.com

# Azure Blob
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=roadlytics

# Backend runtime
ROADLYTICS_DEBUG=false
ROADLYTICS_WORKER_CONCURRENCY=1
ROADLYTICS_MODEL_WEIGHTS_DIR=/app/model_weights
ROADLYTICS_OSM_DIR=/app/data/osm_roads
ROADLYTICS_SEG_WEIGHTS=
ROADLYTICS_CLS_WEIGHTS=
ROADLYTICS_PROCESSOR=local
ROADLYTICS_MODAL_APP=roadlytics-inference
ROADLYTICS_MODAL_FUNCTION=run_pipeline
ROADLYTICS_MODAL_ENVIRONMENT=main
ROADLYTICS_MODAL_PROGRESS_POLL_SECONDS=10
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
GEMINI_API_KEY=
ROADLYTICS_ASSISTANT_MODEL=gemini-2.5-flash
ROADLYTICS_ASSISTANT_EMBEDDING_MODEL=gemini-embedding-001
ROADLYTICS_ASSISTANT_CHROMA_PATH=/app/backend/data/chroma
ROADLYTICS_ASSISTANT_MAX_CONTEXT_CHARS=18000

# Docker build behavior
# Keep false for Modal deployments so the VM does not install GPU/ML pipeline dependencies.
ROADLYTICS_INSTALL_PIPELINE=false

# Frontend build-time settings
NEXT_PUBLIC_API_BASE_URL=https://your-domain.example.com
NEXT_PUBLIC_BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_BASEMAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
